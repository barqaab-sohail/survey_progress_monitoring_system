APP_NAME="HAZECO Transmission and Distribution Losses Calculation Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://hazeco.barqaab.pk/auth/google/callback

# Encrypted disaster recovery; see docs/BACKUPS.md. The private key NEVER belongs on this host.
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_TIMEZONE=Asia/Karachi
BACKUP_PATH=/home/CPANEL_USER/private-survey-backups
BACKUP_PUBLIC_KEY=
BACKUP_DRIVE_FOLDER_ID=
BACKUP_SET=survey-production
BACKUP_RETENTION_DAYS=30
BACKUP_ATTEMPTS=3
BACKUP_RETRY_MINUTES=60
BACKUP_TIMEOUT=1800
BACKUP_HTTP_TIMEOUT=120
BACKUP_MAX_WORKSPACE_BYTES=5368709120
BACKUP_MIN_FREE_BYTES=268435456
BACKUP_MAX_AGE_HOURS=26
BACKUP_MYSQLDUMP=/usr/bin/mysqldump
BACKUP_ALERT_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hazeco_td_losses
DB_USERNAME=hazeco_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Log records emails locally. Use smtp and fill the MAIL_* settings to deliver reset links.
# APP_URL must be the full application base URL (including any deployment subdirectory).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Data Entry MDB: auto uses local Windows DAO, or an HTTPS Windows worker on Linux.
DATA_ENTRY_MDB_DRIVER=auto
# Dedicated worker settings are optional when MDB_EXPORT_WORKER_URL/SECRET are set.
# DATA_ENTRY_MDB_WORKER_URL=https://your-windows-worker.example
# DATA_ENTRY_MDB_WORKER_SECRET=
DATA_ENTRY_MDB_TIMEOUT=180

# Application Drive storage uses the server-side Google OAuth settings above.
# Enable after migrations, administrator consent and worker setup; existing URLs remain valid.
GOOGLE_DRIVE_STORAGE_ENABLED=false
GOOGLE_DRIVE_STORAGE_FOLDER_NAME="Survey source files"
# Leave empty to create a private folder through the application.
GOOGLE_DRIVE_STORAGE_FOLDER_ID=
GOOGLE_DRIVE_STORAGE_QUEUE_CONNECTION=drive-storage
GOOGLE_DRIVE_STORAGE_QUEUE=drive-storage
GOOGLE_DRIVE_STORAGE_TIMEOUT=180

SURVEY_PROGRESS_AUTOMATIC=true
SURVEY_PROGRESS_PROJECT_CODE=HAZECO-TDL
SURVEY_PROGRESS_PARENT_FOLDER=1vu51Yb-eq2hqFaHsmv9km6QZySDoU9sK
SURVEY_PROGRESS_SYNC_TIME=02:00
SURVEY_PROGRESS_QUEUE_CONNECTION=survey-progress
# Reuse GOOGLE_DRIVE_CLIENT_ID/SECRET or provide separate survey-progress credentials.
# SURVEY_PROGRESS_GOOGLE_CLIENT_ID=
# SURVEY_PROGRESS_GOOGLE_CLIENT_SECRET=
# Register this callback in the Google OAuth client before connecting.
# SURVEY_PROGRESS_GOOGLE_REDIRECT_URI=https://hazeco.barqaab.pk/survey-progress/drive/callback
